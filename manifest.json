{
  "manifest_version": 3,
  "name": "TAB STUDIO",
  "description": "TAB STUDIO — Infinity 风格新标签页：真实网站图标、高清壁纸库、3×6 大图标网格、macOS 风格 Dock、文件夹、多分页、待办/笔记/天气小组件与本地备份。",
  "version": "2.1.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "tabs", "favicon"],
  "optional_permissions": ["bookmarks", "history"],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://favicon.im/*",
    "https://icons.duckduckgo.com/*",
    "https://www.google.com/s2/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
