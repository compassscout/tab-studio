{
  "manifest_version": 3,
  "name": "标签页浏览器插件（Infinity 复刻）",
  "description": "Infinity 风格新标签页：站点网格、文件夹收纳、多分页、本地壁纸库、待办小组件与本地备份导出导入，全部数据本地化，无网络请求。",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
